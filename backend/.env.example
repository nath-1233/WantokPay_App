# Copy this file to .env and change the passwords and signing key before use.
POSTGRES_DB=wantokpay
POSTGRES_USER=wantokpay
POSTGRES_PASSWORD=local-development-only-change-this
DATABASE_URL=postgresql+psycopg://wantokpay:local-development-only-change-this@localhost:5432/wantokpay
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_STORAGE_URI=memory://
